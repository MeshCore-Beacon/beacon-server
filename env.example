# Local development starter. Every variable is documented at
# https://github.com/MeshCore-Beacon/beacon-docs/blob/main/docs/configuration.md

LISTEN_ADDR=:8080

# Path to the YAML config (default: config.yaml).
# CONFIG_PATH=config.yaml

# Optional admin bearer key, at least 16 characters with no whitespace.
# If set, overrides auth.api_key (even when empty).
# BEACON_API_KEY=

# Regional or grouped-region API key generated by your local MeshMapper admin.
# A grouped-region key covers multiple regions. Never use the mobile App key.
# Overrides meshmapper.api_key, even when empty. Required for enabled imports.
# Keep this in the deployment environment when using saved-config backups.
# MESHMAPPER_API_KEY=

# Optional application logging overrides (defaults: info / text).
# LOG_LEVEL=info
# LOG_FORMAT=json

POSTGRES_DSN=postgres://beacon:beacon@localhost:5432/beacon?sslmode=disable

# Redis (optional; leave REDIS_ADDR unset to disable caching)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

MQTT_BROKER_1_URL=wss://mqtt1.meshcore.ca:443
MQTT_BROKER_1_USERNAME=
MQTT_BROKER_1_PASSWORD=

MQTT_BROKER_2_URL=wss://mqtt2.meshcore.ca:443
MQTT_BROKER_2_USERNAME=
MQTT_BROKER_2_PASSWORD=

# Optional private CPU captures. Set both; the deadline must be within 72 hours.
# BEACON_CPU_PROFILE_DIR=/profiles
# BEACON_CPU_PROFILE_UNTIL=2026-10-02T12:00:00Z

# SMTP password for the mail block in config.yaml (account mail and email alerts). Never put it in the YAML.
# BEACON_SMTP_PASSWORD=

# Push secret for alert push notifications (alerts.push in config.yaml). You get it, with the Push ID, when you
# register this server at https://push.meshcorebeacon.ca/register. Never put it in the YAML.
# BEACON_PUSH_SECRET=

# Key that seals guest passwords for telemetry requests: 32 random bytes, base64 (openssl rand -base64 32).
# Without it telemetry requests are off. Keep it out of config files and backups.
# BEACON_SECRET_KEY=
